
# ==========================================
# RALLLY - Configuration de l'application
# ==========================================

NEXT_PUBLIC_BASE_URL=http://localhost:3000
SECRET_PASSWORD=replace-with-a-long-random-secret
SUPPORT_EMAIL=admin@example.com

# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_DB=rallly

# Connexion à PostgreSQL depuis Docker
DATABASE_URL=postgresql://postgres:replace-with-a-secure-password@rallly_db:5432/rallly

# ==========================================
# AUTHENTIK - SSO OIDC
# ==========================================

OIDC_NAME=Authentik
OIDC_DISCOVERY_URL=http://authentik.example.local/application/o/rallly/.well-known/openid-configuration
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret

# ==========================================
# REDIS HTTP (service optionnel)
# ==========================================

SRH_MODE=env
SRH_TOKEN=replace-with-a-secure-token
SRH_CONNECTION_STRING=redis://redis:6379

# ==========================================
# GARAGE (stockage optionnel)
# ==========================================

GARAGE_DEFAULT_ACCESS_KEY=replace-with-access-key
GARAGE_DEFAULT_SECRET_KEY=replace-with-secret-key
GARAGE_DEFAULT_BUCKET=rallly

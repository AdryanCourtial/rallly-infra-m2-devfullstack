
# ==========================================
# RALLLY - APPLICATION
# ==========================================

# Connexion PostgreSQL depuis le conteneur Rallly
DATABASE_URL=

# URL publique de Rallly
NEXT_PUBLIC_BASE_URL=


# Nom affiché pour le fournisseur de connexion
OIDC_NAME=

# URL de découverte OpenID Connect
OIDC_DISCOVERY_URL=

# Identifiants du fournisseur OIDC Authentik
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Base de données PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# dans le Docker Compose
SRH_MODE=
SRH_TOKEN=
SRH_CONNECTION_STRING=

# Service Garage
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_SECRET_KEY=
GARAGE_DEFAULT_BUCKET=
